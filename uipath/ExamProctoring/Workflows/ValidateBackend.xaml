    <ui:InvokeCode Code="Try&#xA;    out_IsHealthy = False&#xA;    Dim baseUrl As String = &quot;http://127.0.0.1:5000&quot;&#xA;    Dim apiKey As String = &quot;&quot;&#xA;    If in_Config IsNot Nothing Then&#xA;        If in_Config.ContainsKey(&quot;ApiBaseUrl&quot;) Then baseUrl = in_Config(&quot;ApiBaseUrl&quot;)&#xA;        If in_Config.ContainsKey(&quot;ApiKey&quot;) Then apiKey = in_Config(&quot;ApiKey&quot;)&#xA;    End If&#xA;    Dim url As String = baseUrl.TrimEnd(&quot;/&quot;c) + &quot;/api/health&quot;&#xA;    Using client As New System.Net.Http.HttpClient()&#xA;        client.Timeout = System.TimeSpan.FromSeconds(5)&#xA;        If Not String.IsNullOrWhiteSpace(apiKey) Then&#xA;            client.DefaultRequestHeaders.Add(&quot;X-API-Key&quot;, apiKey)&#xA;        End If&#xA;        Dim response = client.GetAsync(url).GetAwaiter().GetResult()&#xA;        Dim body As String = response.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;        Dim lowerBody As String = body.ToLower()&#xA;        If response.IsSuccessStatusCode AndAlso lowerBody.Contains(&quot;&quot;&quot;status&quot;&quot;&quot;) AndAlso lowerBody.Contains(&quot;&quot;&quot;healthy&quot;&quot;&quot;) Then&#xA;            out_IsHealthy = True&#xA;            out_StatusMessage = &quot;Backend is online and healthy: &quot; + body&#xA;        Else&#xA;            out_IsHealthy = False&#xA;            out_StatusMessage = &quot;Backend returned status &quot; + CInt(response.StatusCode).ToString() + &quot;: &quot; + body&#xA;        End If&#xA;    End Using&#xA;Catch ex As Exception&#xA;    out_IsHealthy = False&#xA;    out_StatusMessage = &quot;Backend connection error: &quot; + ex.Message&#xA;End Try" ContinueOnError="True" DisplayName="Call Health Endpoint" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
