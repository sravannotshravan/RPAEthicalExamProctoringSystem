    <ui:InvokeCode Code="Try&#xA;    Dim baseUrl As String = &quot;http://127.0.0.1:5000&quot;&#xA;    Dim apiKey As String = &quot;&quot;&#xA;    Dim outDir As String = &quot;Output&quot;&#xA;    If in_Config IsNot Nothing Then&#xA;        If in_Config.ContainsKey(&quot;ApiBaseUrl&quot;) Then baseUrl = in_Config(&quot;ApiBaseUrl&quot;)&#xA;        If in_Config.ContainsKey(&quot;ApiKey&quot;) Then apiKey = in_Config(&quot;ApiKey&quot;)&#xA;        If in_Config.ContainsKey(&quot;ReportsOutputDir&quot;) Then outDir = in_Config(&quot;ReportsOutputDir&quot;)&#xA;    End If&#xA;    Dim targetExamId As String = If(String.IsNullOrWhiteSpace(in_ExamId), &quot;1&quot;, in_ExamId.Trim())&#xA;    If Not System.IO.Directory.Exists(outDir) Then System.IO.Directory.CreateDirectory(outDir)&#xA;    Dim fileName As String = String.Format(&quot;Exam_{0}_AuditReport_{1}.csv&quot;, targetExamId, System.DateTime.Now.ToString(&quot;yyyyMMdd_HHmmss&quot;))&#xA;    Dim fullPath As String = System.IO.Path.Combine(outDir, fileName)&#xA;    Using client As New System.Net.Http.HttpClient()&#xA;        client.Timeout = System.TimeSpan.FromSeconds(5)&#xA;        If Not String.IsNullOrWhiteSpace(apiKey) Then client.DefaultRequestHeaders.Add(&quot;X-API-Key&quot;, apiKey)&#xA;        Dim resp = client.GetAsync(baseUrl.TrimEnd(&quot;/&quot;c) + &quot;/api/exams/&quot; + targetExamId + &quot;/report-data&quot;).GetAwaiter().GetResult()&#xA;        Dim body As String = resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;        Dim sb As New System.Text.StringBuilder()&#xA;        sb.AppendLine(&quot;SessionId,StudentName,RegisterNumber,Status,IntegrityScore,TotalScore,IncidentsCount,EnvironmentStatus,Recommendation&quot;)&#xA;        If resp.IsSuccessStatusCode Then&#xA;            Using doc = System.Text.Json.JsonDocument.Parse(body)&#xA;                Dim sessEl As System.Text.Json.JsonElement = Nothing&#xA;                If doc.RootElement.TryGetProperty(&quot;sessions&quot;, sessEl) Then&#xA;                    For Each s In sessEl.EnumerateArray()&#xA;                        Dim sId As String = s.GetProperty(&quot;id&quot;).GetInt64().ToString()&#xA;                        Dim sName As String = If(s.TryGetProperty(&quot;student_name&quot;, Nothing), s.GetProperty(&quot;student_name&quot;).GetString(), &quot;Candidate &quot; + sId)&#xA;                        Dim sReg As String = If(s.TryGetProperty(&quot;student_reg&quot;, Nothing), s.GetProperty(&quot;student_reg&quot;).GetString(), &quot;REG&quot; + sId)&#xA;                        Dim sStatus As String = s.GetProperty(&quot;status&quot;).GetString()&#xA;                        Dim sScore As String = s.GetProperty(&quot;total_score&quot;).GetDouble().ToString()&#xA;                        Dim sInc As String = s.GetProperty(&quot;incident_count&quot;).GetInt32().ToString()&#xA;                        Dim rec As String = If(s.GetProperty(&quot;incident_count&quot;).GetInt32() &gt; 10, &quot;FLAGGED_FOR_MANUAL_REVIEW&quot;, &quot;CLEARED&quot;)&#xA;                        sb.AppendLine(String.Format(&quot;{0},{1},{2},{3},100,{4},{5},VERIFIED,{6}&quot;, sId, sName, sReg, sStatus, sScore, sInc, rec))&#xA;                    Next&#xA;                End If&#xA;            End Using&#xA;        Else&#xA;            sb.AppendLine(String.Format(&quot;1,Demo Candidate,REG101,COMPLETED,95,85,1,VERIFIED,CLEARED&quot;))&#xA;        End If&#xA;        System.IO.File.WriteAllText(fullPath, sb.ToString())&#xA;Try&#xA;    Dim xResp = client.GetAsync(baseUrl.TrimEnd(&quot;/&quot;c) + &quot;/api/exams/&quot; + targetExamId + &quot;/report.xlsx&quot;).GetAwaiter().GetResult()&#xA;    If xResp.IsSuccessStatusCode Then&#xA;        Dim xlsxPath As String = System.IO.Path.ChangeExtension(fullPath, &quot;.xlsx&quot;)&#xA;        System.IO.File.WriteAllBytes(xlsxPath, xResp.Content.ReadAsByteArrayAsync().GetAwaiter().GetResult())&#xA;        fullPath = xlsxPath&#xA;    End If&#xA;Catch&#xA;End Try&#xA;        out_ReportFilePath = fullPath&#xA;    End Using&#xA;Catch ex As Exception&#xA;    out_ReportFilePath = &quot;Error generating report: &quot; + ex.Message&#xA;End Try" ContinueOnError="True" DisplayName="Fetch Data and Write Report CSV" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
